{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/cars/:slug", "destination": "/car" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
